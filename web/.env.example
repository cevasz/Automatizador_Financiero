# Copiar a .env.local y rellenar con los valores de
# Supabase → Project Settings → API.
#
# Ambas son publicas por diseño (viajan en el bundle del navegador). Lo que
# protege los datos es Row Level Security, no el secreto de estas llaves.
# La service_role key NO va aqui ni en ningun archivo del repo.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
