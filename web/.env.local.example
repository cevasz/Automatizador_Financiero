# Copiar a web/.env.local (que NO se versiona) y rellenar con los datos del
# proyecto de Supabase — Project Settings → API. Ver backend/README.md.
#
# Solo la `anon key`. La `service_role` key NUNCA va aqui: se salta Row Level
# Security por completo y podria leer y borrar los datos de cualquier usuario.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
