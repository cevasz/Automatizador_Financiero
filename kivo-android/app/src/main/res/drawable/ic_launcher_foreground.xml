<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        Kivo geometric K mark (safe zone 66dp centered: 21..87).
        Fondo (ic_launcher_background) es coral #F56565. Antes el monograma se
        pintaba también en coral y quedaba invisible sobre sí mismo — ahora usa
        crema (#FEFCF5) para contraste, y se agrega la "moneda teal" que pide
        CLAUDE.md ("monograma K + moneda teal sobre fondo coral").
    -->
    <!-- Top-left triangle petal -->
    <path
        android:fillColor="#FEFCF5"
        android:pathData="M35,32 L48,32 L48,48 Z"
        android:fillAlpha="0.95" />

    <!-- Bottom-left teardrop petal -->
    <path
        android:fillColor="#FEFCF5"
        android:pathData="M35,56 Q35,48 42,48 L48,48 L48,76 Q42,76 35,68 Z" />

    <!-- Top-right diagonal arm -->
    <path
        android:fillColor="#FEFCF5"
        android:pathData="M52,32 L75,32 Q72,40 64,48 L52,48 Z"
        android:fillAlpha="0.95" />

    <!-- Bottom-right diagonal arm -->
    <path
        android:fillColor="#FEFCF5"
        android:pathData="M52,56 L64,56 Q72,64 75,76 L52,76 Z" />

    <!-- Center dark navy accent piece -->
    <path
        android:fillColor="#2D3748"
        android:pathData="M48,48 L56,48 L64,56 L56,56 L48,64 L48,56 Z" />

    <!-- Moneda teal (accent "coin"), esquina superior derecha -->
    <path
        android:fillColor="#2C7A7B"
        android:pathData="M86,29 a8,8 0 1,0 -16,0 a8,8 0 1,0 16,0 Z" />
    <path
        android:fillColor="#6FC9C6"
        android:fillAlpha="0.9"
        android:pathData="M82.5,29 a4.5,4.5 0 1,0 -9,0 a4.5,4.5 0 1,0 9,0 Z" />

</vector>
